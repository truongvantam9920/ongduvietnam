# Server configuration
PORT=5050
NODE_ENV=development

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Administrator Credentials (Bcrypt Hashed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=contact@ongduvietnam.vn

# Database
DATABASE_PATH=./data/ongdu.sqlite

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ongduvietnam
R2_PUBLIC_DOMAIN=

# Client App Info
VITE_APP_TITLE="Ong Dú Việt Nam - Mật Ong Dú Thiên Nhiên Thượng Hạng"
VITE_HOTLINE="0384 575 593"
VITE_ZALO="0384575593"
VITE_ADDRESS="Thôn Suối Cát, Huyện Cam Lâm, Tỉnh Khánh Hòa, Việt Nam"
VITE_SITE_URL="https://www.ongduvietnam.org"

